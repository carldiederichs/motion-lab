  "code": {
    "language": "ts",
    "lines": [
      "function reverse(head) {",
      "  let prev = null, curr = head;",
      "  while (curr) {",
      "    const next = curr.next;",
      "    curr.next = prev;",
      "    prev = curr;",
      "    curr = next;",
      "  }",
      "  return prev;",
      "}"
    ],
