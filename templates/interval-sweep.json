  "edgeCases": [
    {
      "label": "Touching endpoints",
      "why": "End before start prevents a false overlap.",
      "variant": 1
    },
    {
      "label": "No work",
      "why": "An empty event list has peak zero.",
      "variant": 2
    }
  ],
  "code": {
    "language": "ts",
    "lines": [
      "const events = jobs.flatMap(([start, end]) =>",
      "  [[start, 1], [end, -1]]);",
      "events.sort((a, b) => a[0] - b[0] || a[1] - b[1]);",
      "let active = 0, peak = 0;",
      "for (const [, delta] of events) {",
      "  active += delta;",
      "  peak = Math.max(peak, active);",
      "}",
      "return peak;"
    ]
  },
  "complexity": {
    "time": "O(n log n)",
    "space": "O(n)",
    "example": "Two events per job; sort them, then scan once.",
    "derivation": [
      "Assume valid intervals with start < end.",
      "Sorting 2n events dominates the linear scan."
    ]
  }
}
