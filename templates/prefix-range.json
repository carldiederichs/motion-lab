    {
      "label": "Empty range",
      "why": "The same prefix is subtracted from itself.",
      "variant": 1
    },
    {
      "label": "Negative values",
      "why": "Prefix sums need not increase.",
      "variant": 2
    }
  ],
  "code": {
    "language": "ts",
    "lines": [
      "function prefixes(values: number[]) {",
      "  const p = [0];",
      "  for (const value of values) {",
      "    p.push(p[p.length - 1] + value);",
      "  }",
      "  // Sum [left, right): p[right] - p[left]",
      "  return p;",
      "}"
    ]
  },
  "complexity": {
    "time": "O(n) build; O(1) query",
    "space": "O(n)",
    "example": "Store n + 1 totals, then subtract two of them.",
    "derivation": [
      "One addition per input value builds the table.",
      "Each range query reads two totals and subtracts once."
    ]
  }
