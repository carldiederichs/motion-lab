          "for (Cell cell : grid) {",
          "  if (!cell.land || visited.contains(cell)) continue;",
          "  islands++; stack.push(cell); visited.add(cell);",
          "  while (!stack.isEmpty()) {",
          "    Cell current = stack.pop();",
          "    for (Cell next : current.neighbours) {",
          "      if (next.land && visited.add(next))",
          "        stack.push(next);",
          "    }",
          "  }",
          "}"
