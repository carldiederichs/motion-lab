    "lines": [
      "let lo = 0, hi = values.length - 1;",
      "while (lo <= hi) {",
      "  const mid = Math.floor((lo + hi) / 2);",
      "  if (values[mid] === target) return mid;",
      "  if (values[mid] < target) lo = mid + 1;",
      "  else hi = mid - 1;",
      "}",
      "return -1;"
