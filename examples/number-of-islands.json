        "lines": [
          "# Cells expose land and neighbours; identity is stable.",
          "for cell in grid:",
          "    if not cell.land or cell in visited:",
          "        continue",
          "    islands += 1",
          "    stack.append(cell)",
          "    visited.add(cell)",
          "    while stack:",
