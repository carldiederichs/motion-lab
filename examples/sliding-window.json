      "function maxWindow(nums, k) {",
      "  if (k < 1 || k > nums.length) return null;",
      "  let sum = 0;",
      "  for (let j = 0; j < k; j++) sum += nums[j];",
      "  let best = sum;",
      "  for (let i = k; i < nums.length; i++) {",
      "    sum += nums[i] - nums[i - k];",
      "    best = Math.max(best, sum);",
      "  }",
      "  return best;",
      "}"
