{
  "name": "motion-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs --local",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:privacy": "node scripts/privacy.mjs",
    "start": "node scripts/serve.mjs --host 0.0.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
