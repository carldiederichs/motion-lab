    {
      "label": "Brute force",
      "params": {
        "method": "brute"
      },
      "code": {
        "language": "ts",
        "lines": [
          "function bestWindow(nums, k) {",
          "  if (k < 1 || k > nums.length) return null;",
          "  let best = -Infinity;",
          "  for (let start = 0; start + k <= nums.length; start++) {",
          "    let sum = 0;",
          "    for (let j = start; j < start + k; j++) {",
          "      sum += nums[j];",
          "    }",
          "    best = Math.max(best, sum);",
          "  }",
          "  return best;",
          "}"
        ]
      },
      "complexity": {
        "time": "O(n·k)",
        "space": "O(1)",
        "derivation": [
          "n is the array length and k the window size. Each of n−k+1 windows adds k values again. Only counters and a running sum are stored."
        ]
      }
    }
  ],
  "code": {
    "language": "ts",
    "lines": [
      "function maxWindow(nums, k) {",
      "  if (k < 1 || k > nums.length) return null;",
      "  let sum = 0;",
      "  for (let j = 0; j < k; j++) sum += nums[j];",
      "  let best = sum;",
      "  for (let i = k; i < nums.length; i++) {",
      "    sum += nums[i] - nums[i - k];",
      "    best = Math.max(best, sum);",
      "  }",
      "  return best;",
      "}"
    ]
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(1)",
    "example": "Prime k values, then make n−k updates with one addition and one subtraction. Brute force repeats k additions per window.",
    "derivation": [
      "n is the array length and k the window size. Prime k values, then make n−k updates with one addition and one subtraction. Only counters and running sums are stored; the input array is not copied."
    ]
  },
