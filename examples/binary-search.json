{
  "kind": "motion",
  "version": 3,
  "slug": "binary-search",
  "title": "Binary Search",
  "subtitle": "Keep the possible interval visible while each comparison removes half the candidates.",
  "component": "Algorithms",
  "date": "2026-10-22",
  "aliases": ["Binary Search", "Search interval"],
  "stage": {
    "width": 960,
    "height": 480
  },
  "camera": false,
  "defaultPanel": "none",
  "family": "Search interval",
  "simulation": {
    "generator": "binary-search",
    "params": [
      {
        "id": "values",
        "label": "Sorted numbers",
        "type": "numbers",
        "default": [1, 3, 5, 7, 9, 11, 13],
        "max": 10,
        "allowEmpty": true
      },
      {
        "id": "target",
        "label": "Target",
        "type": "int",
        "default": 9,
        "min": -99,
        "max": 99
      }
    ]
  },
  "code": {
    "language": "ts",
    "lines": [
      "let lo = 0, hi = values.length - 1;",
      "while (lo <= hi) {",
      "  const mid = Math.floor((lo + hi) / 2);",
      "  if (values[mid] === target) return mid;",
      "  if (values[mid] < target) lo = mid + 1;",
      "  else hi = mid - 1;",
      "}",
      "return -1;"
    ]
  },
  "complexity": {
    "time": "O(log n)",
    "space": "O(1)",
    "example": "Each comparison halves the remaining interval. Bounds and midpoint use constant extra memory.",
    "derivation": [
      "n is the number of values in an already sorted input. Each comparison halves the remaining interval. Bounds and midpoint use O(1) extra memory. Sorting an unsorted input is separate work."
    ]
  },
  "edgeCases": [
    {
      "label": "Missing target",
      "why": "The interval becomes empty.",
      "params": {
        "values": [1, 3, 5, 7],
        "target": 6
      }
    },
    {
      "label": "Empty input",
      "why": "No midpoint may be read.",
      "params": {
        "values": [],
        "target": 1
      }
    }
  ]
}
