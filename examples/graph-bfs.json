  "code": {
    "language": "ts",
    "lines": [
      "const queue = [start], distance = new Map([[start, 0]]);",
      "let head = 0;",
      "while (head < queue.length) {",
      "  const node = queue[head++];",
      "  for (const next of neighbours(node)) {",
      "    if (distance.has(next)) continue;",
      "    distance.set(next, distance.get(node) + 1);",
      "    queue.push(next);",
      "  }",
      "}",
      "return distance;"
    ],
