          "for (Cell* cell : grid) {",
          "  if (!cell->land || visited.count(cell)) continue;",
          "  ++islands; stack.push(cell); visited.insert(cell);",
          "  while (!stack.empty()) {",
          "    Cell* current = stack.top(); stack.pop();",
          "    for (Cell* next : current->neighbours) {",
