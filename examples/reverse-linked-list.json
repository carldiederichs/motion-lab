          "  Node* prev = nullptr;",
          "  Node* curr = head;",
          "  while (curr != nullptr) {",
          "    Node* next = curr->next;",
          "    curr->next = prev;",
          "    prev = curr;",
          "    curr = next;",
          "  }",
          "  return prev;",
          "}"
