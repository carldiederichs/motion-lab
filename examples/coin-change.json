          "    dp = [float('inf')] * (amount + 1)",
          "    dp[0] = 0",
          "    for a in range(1, amount + 1):",
          "        for c in coins:",
          "            if c <= a:",
          "                dp[a] = min(dp[a], dp[a - c] + 1)",
          "    result = dp[amount]",
          "    return -1 if result == float('inf') else result"
