          "def bfs(graph, start):",
          "    queue, distance = [start], {start: 0}",
          "    head = 0",
          "    while head < len(queue):",
          "        node = queue[head]",
          "        head += 1",
          "        for nxt in graph[node]:",
          "            if nxt in distance:",
          "                continue",
          "            distance[nxt] = distance[node] + 1",
          "            queue.append(nxt)",
          "    return distance"
        ],
