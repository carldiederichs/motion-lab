  "variants": [
    {
      "label": "Postorder",
      "params": {
        "method": "postorder"
      },
      "code": {
        "language": "ts",
        "lines": [
          "function heightOrFail(node) {",
          "  if (!node) return 0;",
          "  const left = heightOrFail(node.left);",
          "  if (left === -1) return -1;",
          "  const right = heightOrFail(node.right);",
          "  if (right === -1) return -1;",
          "  if (Math.abs(left - right) > 1) return -1;",
          "  return 1 + Math.max(left, right);",
          "}",
          "const balanced = heightOrFail(root) !== -1;"
        ]
      },
      "complexity": {
        "time": "O(n)",
        "space": "O(h)",
        "derivation": [
          "Each node returns its height once. h is the tree height."
        ]
      }
    },
    {
      "label": "Repeated heights",
      "params": {
        "method": "repeated"
      },
      "code": {
        "language": "ts",
        "lines": [
          "function height(node) {",
          "  if (!node) return 0;",
          "  return 1 + Math.max(",
          "    height(node.left), height(node.right));",
          "}",
          "function isBalanced(node) {",
          "  if (!node) return true;",
          "  const left = height(node.left);",
          "  const right = height(node.right);",
          "  if (Math.abs(left - right) > 1) return false;",
          "  return isBalanced(node.left) &&",
          "    isBalanced(node.right);",
          "}"
        ]
      },
      "complexity": {
        "time": "O(n\u00b2) upper bound",
        "space": "O(h)",
        "derivation": [
          "Repeated height scans add work. Balanced trees take O(n log n); a skewed tree can fail at the root after one scan."
        ]
      }
    }
  ],
  "edgeCases": [
