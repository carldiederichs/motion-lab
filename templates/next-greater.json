  "edgeCases": [
    {
      "label": "No later greater value",
      "why": "Check decreasing and duplicate values.",
      "variant": 1
    },
    {
      "label": "Equal values wait",
      "why": "Check decreasing and duplicate values.",
      "variant": 2
    }
  ],
  "code": {
    "title": "Illustrative pseudocode",
    "language": "ts",
    "lines": [
      "const answer = Array(values.length).fill(-1);",
      "const stack = [];",
      "for (let i = 0; i < values.length; i++) {",
      "  while (stack.length &&",
      "  values[stack.at(-1)] < values[i]) {",
      "    answer[stack.pop()] = values[i];",
      "  }",
      "  stack.push(i);",
      "}",
      "return answer;"
    ]
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(n)",
    "derivation": [
      "n is the number of input values. Each index is pushed once and popped at most once, so all while-loop iterations total at most n.",
      "The stack and output each hold at most n entries."
    ]
  }
}
