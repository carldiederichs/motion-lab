      "variant": 2
    }
  ],
  "code": {
    "language": "ts",
    "lines": [
      "let node = root;",
      "for (const char of word) {",
      "  node = node.children.get(char);",
      "  if (!node) return false;",
      "}",
      "return node.terminal === true;"
    ]
  },
  "complexity": {
    "time": "O(m)",
    "space": "O(1) per lookup",
    "example": "Look up m characters in an existing trie.",
    "derivation": [
      "m is the query length. Child-map lookup is expected O(1).",
      "Each character follows one child map lookup.",
      "The existing trie storage is not allocated by the query."
    ]
  }
