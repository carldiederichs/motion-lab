        "lines": [
          "int coinChange(",
          "    const std::vector<int>& coins, int amount) {",
          "  std::vector<int> dp(amount + 1, amount + 1);",
          "  dp[0] = 0;",
          "  for (int a = 1; a <= amount; ++a) {",
          "    for (int c : coins) {",
          "      if (c <= a)",
          "        dp[a] = std::min(dp[a], dp[a - c] + 1);",
          "    }",
          "  }",
          "  return dp[amount] > amount ? -1 : dp[amount];",
          "}"
        ],
