{
  "name": "motion-lab",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "tsx scripts/build.ts && tsx scripts/serve.ts --local",
    "preview": "tsx scripts/serve.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check:privacy": "tsx scripts/privacy.ts",
    "start": "tsx scripts/serve.ts --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test:languages": "tsx scripts/test-code-languages.ts",
    "posttest": "tsx scripts/test-ci.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
