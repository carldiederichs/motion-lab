    "language": "ts",
    "lines": [
      "for (const cell of grid) {",
      "  if (!cell.land || visited.has(cell)) continue;",
      "  islands++; stack.push(cell); visited.add(cell);",
      "  while (stack.length) {",
      "    visitAndPushUnseenNeighbours(stack.pop());",
      "  }",
      "}"
